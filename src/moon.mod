name = "Haoxincode/moonbash"

version = "0.1.0"

import {
  "moonbitlang/regexp@0.3.7",
  "gmlewis/md5@0.20.3",
  "gmlewis/sha1@0.12.19",
  "gmlewis/io@0.23.22",
  "moonbit-community/yaml@0.0.10",
  "gmlewis/gzip@0.34.19",
  "gmlewis/flate@0.36.19",
  "gmlewis/base64@0.16.15",
  "moonbit-community/piediff@0.1.2",
  "justjavac/glob@0.2.0",
  "bobzhang/moonjq@0.2.0",
  "tiye/dom-ffi@0.5.1",
  "moonbitlang/async@0.22.9",
  "peter-jerry-ye/parse_args@0.1.2",
  "tonyfettes/url@0.3.5",
  "moonbitlang/x@0.5.7",
}

readme = "README.md"

repository = "https://github.com/Haoxincode/MoonBash"

license = "Apache-2.0"

keywords = [ "bash", "shell", "sandbox" ]

description = "Zero-dependency pure-memory POSIX Shell sandbox"

preferred_target = "js"

supported_targets = "js"
